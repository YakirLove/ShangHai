{
  "id": "shanghai-roam",
  "name": "上海漫游",
  "description": "探索上海全市，步行、驾车、骑行或飞行；按线路寻找地铁站，在地图筛选地点并飞往目的地。",
  "category": "3D 探索",
  "cover": "assets/market-cover.png",
  "icon": "assets/market-icon.svg",
  "build": ["npm", "run", "build", "--", "--outDir={build_dir}/dist"],
  "output_dir": "{build_dir}/dist",
  "route": "static",
  "gzip": true,
  "domains": ["shanghai.datiaomao.com"],
  "health_paths": ["boot-manifest.json", "data/city.json", "data/manifest.json", "data/metro.json"]
}
